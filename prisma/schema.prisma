// Reigna — Prisma schema
// Data model reflects the PRD's core entities: User (single-operator auth),
// Contact, Campaign, Message, SenderIdentity, ProviderAccount, WebhookEvent,
// ResearchRun/ResearchSource, Event, SuppressionEntry — plus the supporting
// join/config types needed to run discovery, verification, research,
// personalization, review, sending, tracking, and follow-up against real
// external providers (Apify, Hunter, Tavily, Anthropic, Instantly).
//
// NOTE: This is a real-data-only application. No demo/seed business records
// exist. Every table starts empty on a fresh database, and the UI renders
// intentional empty states until real records are created through the
// product's own pipeline (discovery, review, sending, tracking). See
// /docs/DECISIONS.md and /src/lib/services for how each domain area reports
// "not yet connected" vs "connected but empty".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  RISKY
  INVALID
}

enum ContactSource {
  DISCOVERY
  MANUAL
  IMPORT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum MessageStatus {
  DRAFTED
  NEEDS_REVIEW
  APPROVED
  QUEUED
  SENT
  FOLLOWED_UP
  REJECTED
  FAILED
}

enum MessageVariant {
  INITIAL
  FOLLOW_UP
}

enum WarmupStatus {
  WARMING
  READY
  PAUSED
}

enum EventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  COMPLAINED
  INTERESTED
  NOT_INTERESTED
  OUT_OF_OFFICE
  AUTO_REPLIED
  WRONG_PERSON
}

enum ReplyClassification {
  INTERESTED
  NOT_INTERESTED
  OUT_OF_OFFICE
  AUTO_REPLY
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
}

enum MailboxProvider {
  GOOGLE
  MICROSOFT
}

enum ProviderAccountStatus {
  PENDING
  CONNECTED
  FAILED
}

enum ResearchRunStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Auth / ownership
// ---------------------------------------------------------------------------

// Single-operator account. v1 has exactly one active owner per deployment,
// but every major record carries an ownerId so the product can grow into
// multi-seat teams later without a data migration.
model User {
  id           String   @id @default(cuid())
  firebaseUid  String?  @unique
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts           Contact[]
  campaigns          Campaign[]
  senderIdentities   SenderIdentity[]
  suppressionEntries SuppressionEntry[]
  providerAccounts   ProviderAccount[]
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model Contact {
  id                 String             @id @default(cuid())
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id])
  company            String
  companyDomain      String?
  companyAddress     String?
  companyPhone       String?
  companyCategory    String?
  name               String
  title              String?
  email              String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  emailConfidence    Int?
  decisionMakerScore Int?
  source             ContactSource      @default(DISCOVERY)
  sourceUrl          String?
  engagementScore    Int                @default(0)

  // Research context captured during the discovery/research pipeline.
  researchSummary String?
  researchSignals Json?
  whyThisPerson   String?
  recommendation  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages         Message[]
  campaignContacts CampaignContact[]
  researchRuns     ResearchRun[]

  @@unique([ownerId, email])
  @@index([company])
  @@index([engagementScore])
  @@index([ownerId])
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  ownerId          String
  owner            User           @relation(fields: [ownerId], references: [id])
  senderIdentityId String
  senderIdentity   SenderIdentity @relation(fields: [senderIdentityId], references: [id])
  status           CampaignStatus @default(DRAFT)

  // Follow-up configuration (v1: a single follow-up step).
  followUpEnabled   Boolean @default(true)
  followUpDelayDays Int     @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts        CampaignContact[]
  messages        Message[]
  providerMapping CampaignProviderMapping?

  @@index([status])
  @@index([ownerId])
}

// Join table: which contacts belong to which campaign, and their per-campaign state.
model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id])
  addedAt    DateTime @default(now())

  @@unique([campaignId, contactId])
}

model Message {
  id         String         @id @default(cuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id])
  contactId  String
  contact    Contact        @relation(fields: [contactId], references: [id])
  variant    MessageVariant @default(INITIAL)

  subject         String
  subjectVariants Json?
  body            String
  researchBasis   String?

  status              MessageStatus        @default(DRAFTED)
  replyClassification ReplyClassification?
  providerMessageId   String?
  sentAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([status])
  @@index([campaignId])
}

model SenderIdentity {
  id                String           @id @default(cuid())
  ownerId           String
  owner             User             @relation(fields: [ownerId], references: [id])
  provider          MailboxProvider?
  providerAccountId String?
  domain            String
  mailbox           String
  firstName         String?
  lastName          String?
  voiceGuidance     String?

  dailyCap     Int          @default(30)
  sentToday    Int          @default(0)
  warmupStatus WarmupStatus @default(WARMING)
  warmupScore  Int?

  spfValid   Boolean @default(false)
  dkimValid  Boolean @default(false)
  dmarcValid Boolean @default(false)

  bounceRate    Float @default(0)
  complaintRate Float @default(0)

  providerStatus        String?
  providerStatusMessage String?
  connectedAt           DateTime?
  lastSyncedAt          DateTime?
  lastDnsCheckedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns       Campaign[]
  providerAccount ProviderAccount?

  @@unique([mailbox])
  @@index([ownerId])
}

// Tracks an in-progress or completed Instantly-brokered mailbox OAuth
// connection. Ephemeral by nature — polled by the client via sessionId
// until status resolves to CONNECTED or FAILED, then linked to the
// SenderIdentity it produced.
model ProviderAccount {
  id               String                @id @default(cuid())
  ownerId          String
  owner            User                  @relation(fields: [ownerId], references: [id])
  provider         MailboxProvider
  sessionId        String                @unique
  status           ProviderAccountStatus @default(PENDING)
  statusMessage    String?
  senderIdentityId String?               @unique
  senderIdentity   SenderIdentity?       @relation(fields: [senderIdentityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Local record of a Reigna campaign's corresponding Instantly campaign.
// Reigna's own database remains the product's source of truth; this row
// just lets Reigna keep provider state (leads, sequence, schedule) in sync.
model CampaignProviderMapping {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  campaign           Campaign @relation(fields: [campaignId], references: [id])
  provider           String   @default("INSTANTLY")
  providerCampaignId String
  syncedAt           DateTime @default(now())
}

model Event {
  id         String    @id @default(cuid())
  messageId  String
  message    Message   @relation(fields: [messageId], references: [id])
  type       EventType
  metadata   Json?
  occurredAt DateTime  @default(now())

  @@index([messageId])
  @@index([type])
}

// Raw idempotency ledger for inbound provider webhooks. A webhook event id
// arriving twice must not create duplicate Event rows — this table is the
// dedupe boundary, keyed on (provider, externalId).
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
}

model SuppressionEntry {
  id      String            @id @default(cuid())
  ownerId String
  owner   User              @relation(fields: [ownerId], references: [id])
  email   String
  reason  SuppressionReason
  addedAt DateTime          @default(now())

  @@unique([ownerId, email])
}

// Raw research evidence gathered for a contact, separated from the
// summarized fields stored directly on Contact. Lets Reigna answer "why did
// you write this?" with real, sourced evidence rather than a black box.
model ResearchRun {
  id          String            @id @default(cuid())
  contactId   String
  contact     Contact           @relation(fields: [contactId], references: [id])
  status      ResearchRunStatus @default(PENDING)
  summary     String?
  error       String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  sources ResearchSource[]

  @@index([contactId])
}

model ResearchSource {
  id            String      @id @default(cuid())
  researchRunId String
  researchRun   ResearchRun @relation(fields: [researchRunId], references: [id])
  url           String
  title         String?
  snippet       String?
  sourceType    String?
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([researchRunId])
}
